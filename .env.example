# Copy to .env and fill in. Never commit .env.
POSTGRES_DB=glassbox
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
GLASSBOX_OWNER_PASSWORD=change-me-owner
GLASSBOX_APP_PASSWORD=change-me-app

# 32+ random chars; used to sign JWTs
GLASSBOX_JWT_SECRET=change-me-at-least-32-characters-long
# base64 of 32 random bytes; used for AES-GCM of provider keys
GLASSBOX_ENCRYPTION_KEY=

# Language model for answers: any OpenAI-compatible endpoint. Defaults to Ollama on the host machine.
# GLASSBOX_LLM_BASE_URL=http://host.docker.internal:11434
# GLASSBOX_LLM_MODEL=llama3.2:3b
# GLASSBOX_LLM_API_KEY=
